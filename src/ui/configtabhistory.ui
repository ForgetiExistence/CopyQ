   <string notr="true">QScrollArea#ConfigTabHistory { background-color: #F3F3F3; border: none; }
QDialog { background-color: #F3F3F3; }
QPushButton { border-radius: 4px; padding: 5px 12px; min-height: 24px; border: 1px solid #E5E5E5; background-color: #FBFBFB; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox { border-radius: 4px; border: 1px solid #D1D1D1; padding: 5px 8px; background-color: #FFFFFF; }
QComboBox { border-radius: 4px; border: 1px solid #D1D1D1; padding: 5px 8px; min-height: 24px; background-color: #FFFFFF; }
QCheckBox, QRadioButton { spacing: 8px; }
QGroupBox { border-radius: 8px; border: 1px solid #E5E5E5; margin-top: 12px; padding: 12px; background-color: #FBFBFB; }
QListWidget, QTreeWidget, QTableWidget { border-radius: 8px; border: 1px solid #E5E5E5; }
QTabWidget::pane { border: 1px solid #E5E5E5; border-radius: 8px; }
QTabBar::tab { border-radius: 4px; padding: 6px 16px; margin-right: 4px; }
QTabBar::tab:selected { background-color: #0078D4; color: #FFFFFF; }
QScrollBar { border: none; background: transparent; width: 8px; height: 8px; margin: 0; }
QScrollBar::handle { background: #C0C0C0; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:hover { background: #A0A0A0; }
QScrollBar::add-line, QScrollBar::sub-line { border: none; background: none; width: 0px; height: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QMenu { border-radius: 8px; border: 1px solid #E5E5E5; padding: 4px; }</string>
