   <string notr="true">QDialog { background-color: #F3F3F3; }
QPushButton { border-radius: 4px; padding: 5px 12px; border: 1px solid #E5E5E5; background-color: #FBFBFB; min-height: 32px; min-width: 90px; }
QPushButton:hover { background-color: #F5F5F5; }
