QLineEdit, QTextEdit, QPlainTextEdit, QKeySequenceEdit { border-radius: 4px; border: 1px solid #D1D1D1; padding: 5px 8px; background-color: #FFFFFF; min-height: 32px; }
QComboBox { border-radius: 4px; border: 1px solid #D1D1D1; padding: 5px 8px; min-height: 24px; }
QCheckBox, QRadioButton { spacing: 8px; }
QGroupBox { border-radius: 8px; border: 1px solid #E5E5E5; margin-top: 12px; padding: 12px; }
QListWidget, QTreeWidget, QTableWidget { border-radius: 8px; border: 1px solid #E5E5E5; }
QTabWidget::pane { border: 1px solid #E5E5E5; border-radius: 8px; }
QTabBar::tab { border-radius: 4px; padding: 6px 16px; margin-right: 4px; }
QTabBar::tab:selected { background-color: #0078D4; color: #FFFFFF; }
QScrollBar { border: none; background: transparent; width: 8px; margin: 0; }
QScrollBar::handle { background: #C0C0C0; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:hover { background: #A0A0A0; }
QMenu { border-radius: 8px; border: 1px solid #E5E5E5; padding: 4px; }</string>
