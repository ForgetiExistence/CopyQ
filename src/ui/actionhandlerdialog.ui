  <property name="styleSheet">
   <string notr="true">QDialog { background-color: #F3F3F3; }
QWidget { font-family: &quot;Segoe UI&quot;; font-size: 9pt; }
QPushButton { border-radius: 4px; padding: 5px 12px; min-height: 32px; border: 1px solid #E5E5E5; background-color: #FBFBFB; }
QPushButton:hover { background-color: #F6F6F6; border: 1px solid #D1D1D1; }
QPushButton:pressed { background-color: #EDEDED; border: 1px solid #C0C0C0; }
QPushButton:disabled { background-color: #FBFBFB; color: #A0A0A0; border: 1px solid #E5E5E5; }
QPushButton:default { background-color: #0078D4; color: #FFFFFF; border: 1px solid #0078D4; }
QPushButton:default:hover { background-color: #106EBE; border: 1px solid #106EBE; }
QPushButton:default:pressed { background-color: #005A9E; border: 1px solid #005A9E; }
QLineEdit, QTextEdit, QPlainTextEdit { border-radius: 4px; border: 1px solid #D1D1D1; padding: 5px 8px; background-color: #FFFFFF; min-height: 32px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #0078D4; }
QComboBox { border-radius: 4px; border: 1px solid #D1D1D1; padding: 5px 8px; min-height: 24px; background-color: #FBFBFB; }
QCheckBox, QRadioButton { spacing: 8px; }
QGroupBox { border-radius: 8px; border: 1px solid #E5E5E5; margin-top: 12px; padding: 12px; }
QListWidget, QTreeWidget, QTableWidget { border-radius: 8px; border: 1px solid #E5E5E5; }
QTableView { border-radius: 8px; border: 1px solid #E5E5E5; background-color: #FFFFFF; gridline-color: #E5E5E5; selection-background-color: #E5F1FB; selection-color: #1A1A1A; }
QTableView::item:selected { background-color: #E5F1FB; color: #1A1A1A; }
QTableView QHeaderView::section { background-color: #F3F3F3; border: none; border-bottom: 1px solid #E5E5E5; padding: 6px 8px; }
QTabWidget::pane { border: 1px solid #E5E5E5; border-radius: 8px; }
QTabBar::tab { border-radius: 4px; padding: 6px 16px; margin-right: 4px; }
QTabBar::tab:selected { background-color: #0078D4; color: #FFFFFF; }
QScrollBar { border: none; background: transparent; width: 8px; margin: 0; }
QScrollBar::handle { background: #C0C0C0; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:hover { background: #A0A0A0; }
QMenu { border-radius: 8px; border: 1px solid #E5E5E5; padding: 4px; background-color: #FBFBFB; }</string>
