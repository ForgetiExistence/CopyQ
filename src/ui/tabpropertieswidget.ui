  <property name="styleSheet">
   <string notr="true">/* Windows 11 Fluent Design */

QWidget {
    background-color: palette(window);
}

QLabel {
    color: palette(text);
    background: transparent;
}

QPushButton {
    border-radius: 4px;
    padding: 5px 12px;
    min-height: 24px;
    min-width: 96px;
    border: 1px solid palette(mid);
    background-color: palette(button);
    color: palette(text);
}

QPushButton:hover {
    background-color: palette(alternate-base);
}

QPushButton:pressed {
    background-color: palette(midlight);
}

QPushButton:disabled {
    background-color: palette(window);
    border: 1px solid palette(mid);
    color: palette(mid);
}

QLineEdit, QTextEdit, QPlainTextEdit {
    border-radius: 4px;
    border: 1px solid palette(mid);
    padding: 5px 8px;
    background-color: palette(base);
    color: palette(text);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid palette(highlight);
}

QComboBox {
    border-radius: 4px;
    border: 1px solid palette(mid);
    padding: 5px 8px;
    min-height: 24px;
    background-color: palette(base);
    color: palette(text);
}

QComboBox:focus {
    border: 2px solid palette(highlight);
}

QCheckBox {
    spacing: 8px;
}

QRadioButton {
    spacing: 8px;
}

QGroupBox {
    border-radius: 8px;
    border: 1px solid palette(mid);
    margin-top: 12px;
    padding: 12px;
    background-color: palette(button);
}

QListWidget, QTreeWidget, QTableWidget {
    border-radius: 8px;
    border: 1px solid palette(mid);
    background-color: palette(base);
}

QTabWidget::pane {
    border: 1px solid palette(mid);
    border-radius: 8px;
}

QTabBar::tab {
    border-radius: 4px;
    padding: 6px 16px;
    margin-right: 4px;
    background-color: palette(window);
    color: palette(text);
}

QTabBar::tab:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QScrollBar {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle {
    background: palette(mid);
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:hover {
    background: palette(mid);
}

QMenu {
    border-radius: 8px;
    border: 1px solid palette(mid);
    padding: 4px;
    background-color: palette(button);
}

QDialog {
    background-color: palette(window);
}

QSpinBox {
    min-height: 24px;
    min-width: 80px;
    padding-right: 4px;
    border-radius: 4px;
    border: 1px solid palette(mid);
    background-color: palette(base);
    color: palette(text);
}

QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    border: none;
    background: palette(window);
    border-radius: 2px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: palette(mid);
}

QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background: palette(mid);
}

QSpinBox::up-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid palette(text);
}

QSpinBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid palette(text);
}</string>
