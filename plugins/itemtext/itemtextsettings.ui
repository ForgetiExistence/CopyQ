 <class>ItemTextSettings</class>
 <widget class="QWidget" name="ItemTextSettings">
  <property name="styleSheet">
   <string>
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { border-radius: 4px; border: 1px solid #D1D1D1; padding: 5px 8px; min-height: 24px; background: #FFFFFF; }
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #0078D4; }
QPushButton { border-radius: 4px; padding: 5px 12px; min-height: 24px; border: 1px solid #E5E5E5; background: #FBFBFB; }
QPushButton:hover { background: #F5F5F5; }
QPushButton:pressed { background: #E5E5E5; }
QPushButton:default { background: #0078D4; color: #FFFFFF; border: 1px solid #0078D4; }
QPushButton:default:hover { background: #106EBE; }
QCheckBox { spacing: 8px; }
QGroupBox { border-radius: 8px; border: 1px solid #E5E5E5; margin-top: 12px; padding: 12px; background: #FFFFFF; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 8px; left: 12px; }
QListWidget, QTreeWidget, QTableWidget { border-radius: 8px; border: 1px solid #E5E5E5; }
QScrollBar:vertical { border: none; background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #C0C0C0; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #A0A0A0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { border: none; background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: #C0C0C0; border-radius: 4px; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: #A0A0A0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
   </string>
