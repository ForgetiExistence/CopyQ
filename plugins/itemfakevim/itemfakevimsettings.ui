QPushButton { border-radius: 4px; padding: 5px 12px; min-height: 24px; border: 1px solid palette(mid); background: palette(button); }
QPushButton:hover { background: palette(alternate-base); }
QPushButton:pressed { background: palette(mid); }
QPushButton:default { background: palette(highlight); color: palette(highlighted-text); border: 1px solid palette(highlight); }
