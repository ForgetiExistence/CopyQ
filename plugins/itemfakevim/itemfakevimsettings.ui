QCheckBox { spacing: 8px; }
QGroupBox { border-radius: 8px; border: 1px solid palette(mid); margin-top: 12px; padding: 12px; background: palette(base); }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 8px; left: 12px; }
QListWidget, QTreeWidget, QTableWidget { border-radius: 8px; border: 1px solid palette(mid); }
QScrollBar:vertical { border: none; background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: palette(mid); border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: palette(mid); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { border: none; background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: palette(mid); border-radius: 4px; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: palette(mid); }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
